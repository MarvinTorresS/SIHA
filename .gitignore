# --- Node.js / TypeScript (api/, Sistema-web/) ---
node_modules/
dist/
build/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Prisma ---
generated/

# --- Variables de entorno y credenciales (NUNCA subir) ---
.env
.env.local
.env.*.local
*.env

# --- Docker ---
pgdata/
postgres-data/

# --- Datos crudos institucionales (Banner) ---
# Contienen datos de profesores (nombre, correo) y son regenerables
# corriendo banner_connector.py -- no se versionan.
# (La malla curricular ya no se scrapea: viene de
# data-extractor/input/PLANES_DE_ESTUDIO.xlsx, verificado a mano y
# versionado, cargado con excel_loader.py.)
data-extractor/output/raw/*.json
data-extractor/output/**/*.json

# --- Reportes generados ---
orphaned_records.csv

# --- Basura de debug ---
api/malla_isi.json

# --- IDEs y editores ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# --- Configuracion local de Claude Code (permisos/preferencias personales) ---
# NO ignorar .claude/skills/ ni CLAUDE.md/PRODUCT.md/DESIGN.md: esos documentan
# convenciones del proyecto y deben seguir versionados.
.claude/settings.local.json
.claude/*.local.json

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini